# ─────────────────────────────────────────────────────────────────
# PanoERP Ortam Değişkenleri — Yerel Geliştirme
# ─────────────────────────────────────────────────────────────────

# Uygulama
APP_NAME="PanoERP"
APP_ENV="development"           # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY="DEGISTIR_gizli_anahtar_buraya_en_az_32_karakter_olsun"
APP_VERSION="0.1.0"

# Veritabanı (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://pano_user:pano_pass@localhost:5432/pano_erp"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false             # SQL sorgularını logla (geliştirmede true yapılabilir)

# JWT Token
JWT_SECRET_KEY="DEGISTIR_jwt_gizli_anahtar_buraya_en_az_64_karakter"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 saat
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Dosya Yükleme
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=50

# Loglama
LOG_LEVEL="INFO"                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE="logs/pano_erp.log"

# QR Kod
QR_BASE_URL="http://localhost:8000"

# İlk Admin Kullanıcısı (seed data için)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@firma.com"
ADMIN_PASSWORD="DEGISTIR_admin_sifresi"
ADMIN_FULL_NAME="Sistem Yöneticisi"
